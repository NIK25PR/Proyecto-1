  <diagram name="0. Mapa" id="p0">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p0-2" value="&lt;b style='font-size:20px'&gt;Club Deportivo Séneca — Modelo de dominio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Una pestaña por paquete. Las flechas indican qué paquete usa clases de cuál.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p0-3" value="&lt;b&gt;1. Usuarios y Turnos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Usuario, Socio, Empleado, Entrenador, Fisioterapeuta, Administrador, RestriccionMedica, Turno, SolicitudCambioTurno&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p0-4" value="&lt;b&gt;3. Partidos y Estadísticas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Partido, EstadisticaIndividual (y una subclase por deporte), Tarjeta, Suspension&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p0-5" value="&lt;b&gt;7. Tienda, Cafetería e Inventario&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Producto, Articulo, ProductoCafeteria, Bebida, Snack, Inventario, Ubicacion, Sugerencia&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
