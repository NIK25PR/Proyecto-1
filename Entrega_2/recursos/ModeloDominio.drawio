          </mxGeometry>
        </mxCell>
        <mxCell id="p6-38" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="p6-36">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint x="23" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6-39" value="&lt;b&gt;Reglas de negocio&lt;/b&gt;&lt;br&gt;• La sesión es de un Equipo (se convoca a todos sus miembros) o de una Academia (un subconjunto de sus inscritos).&lt;br&gt;• Hay una Asistencia por cada convocado; nace PENDIENTE y el entrenador la marca al finalizar.&lt;br&gt;• La evaluación es opcional; la nota va de 1 a 5.&lt;br&gt;• No se convoca a un socio con restricción médica vigente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=16;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="620" width="480" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p6-40" value="&lt;b&gt;Cambios vs. original&lt;/b&gt;&lt;br&gt;• Convocados y asistencia son la misma clase: una Asistencia por convocado.&lt;br&gt;• La evaluación cuelga de la Asistencia de ese socio, no de la sesión.&lt;br&gt;• Entrenador, Instalacion y Socio ahora son relaciones (antes eran textos)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=16;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="680" y="620" width="480" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
