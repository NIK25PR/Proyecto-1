<mxfile host="app.diagrams.net"><diagram id="d0" name="7. Clases detalladas - Club (fachada) y excepcion"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0" background="#000000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="7. Clases detalladas - Club (fachada) y excepcion" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#FFFFFF;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="v0" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Club&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #fff;margin:4px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;- usuarios: List&amp;lt;Usuario&amp;gt;&lt;br&gt;- equipos: List&amp;lt;Equipo&amp;gt;&lt;br&gt;- partidos: List&amp;lt;Partido&amp;gt;&lt;br&gt;- tienda: TiendaCafeteria&lt;br&gt;- academias: List&amp;lt;Academia&amp;gt;&lt;br&gt;- competencias: List&amp;lt;Competencia&amp;gt;&lt;br&gt;- sesiones: List&amp;lt;SesionEntrenamiento&amp;gt;&lt;br&gt;- turnos: List&amp;lt;Turno&amp;gt;&lt;br&gt;- solicitudes: List&amp;lt;SolicitudCambioTurno&amp;gt;&lt;br&gt;+ APERTURA: LocalTime {static}&lt;br&gt;+ CIERRE: LocalTime {static}&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #fff;margin:4px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;+ Club()&lt;br&gt;+ registrarUsuario(u: Usuario)&lt;br&gt;+ buscarUsuario(login: String): Usuario&lt;br&gt;+ autenticar(login: String, password: String): Usuario&lt;br&gt;+ registrarEquipo(e: Equipo)&lt;br&gt;+ buscarEquipo(nombre: String): Equipo&lt;br&gt;+ registrarPartido(p: Partido)&lt;br&gt;+ registrarAcademia(a: Academia)&lt;br&gt;+ buscarAcademia(nombre: String): Academia&lt;br&gt;+ registrarCompetencia(c: Competencia)&lt;br&gt;+ buscarCompetencia(nombre: String): Competencia&lt;br&gt;+ registrarSesion(s: SesionEntrenamiento)&lt;br&gt;+ registrarTurno(t: Turno)&lt;br&gt;+ solicitarCambioTurno(solicitante: Empleado, turno: Turno,&lt;br&gt;      nuevoDia: DayOfWeek, nuevaHoraInicio: LocalTime,&lt;br&gt;      nuevaHoraFin: LocalTime): SolicitudCambioTurno&lt;br&gt;+ resolverSolicitud(admin: Administrador,&lt;br&gt;      s: SolicitudCambioTurno, aprobar: boolean)&lt;br&gt;- horaSinCobertura(dia: DayOfWeek): String&lt;br&gt;+ totalVentas(rubro: Rubro, desde: LocalDate,&lt;br&gt;      hasta: LocalDate): double&lt;br&gt;+ convocatorias(socio: Socio): int&lt;br&gt;+ asistencias(socio: Socio): int&lt;br&gt;+ partidosJugados(): List&amp;lt;Partido&amp;gt;&lt;br&gt;+ evolucionRanking(academia: Academia,&lt;br&gt;      socio: Socio): List&amp;lt;RegistroRanking&amp;gt;&lt;br&gt;+ buscarEquipoDe(s: Socio, d: DeporteConjunto): Equipo&lt;br&gt;+ inscribirJugador(e: Equipo, s: Socio, posicion: String,&lt;br&gt;      numero: int, hoy: LocalDate)&lt;br&gt;+ registrarPartidoInterno(local: Equipo, visitante: Equipo,&lt;br&gt;      fecha: LocalDate): PartidoInterno&lt;br&gt;+ registrarRestriccion(fisio: Fisioterapeuta, s: Socio,&lt;br&gt;      motivo: String, fecha: LocalDate)&lt;br&gt;+ getUsuarios(): List&amp;lt;Usuario&amp;gt;&lt;br&gt;+ getEquipos(): List&amp;lt;Equipo&amp;gt;&lt;br&gt;+ getPartidos(): List&amp;lt;Partido&amp;gt;&lt;br&gt;+ getTienda(): TiendaCafeteria&lt;br&gt;+ getAcademias(): List&amp;lt;Academia&amp;gt;&lt;br&gt;+ getCompetencias(): List&amp;lt;Competencia&amp;gt;&lt;br&gt;+ getSesiones(): List&amp;lt;SesionEntrenamiento&amp;gt;&lt;br&gt;+ getTurnos(): List&amp;lt;Turno&amp;gt;&lt;br&gt;+ getSolicitudes(): List&amp;lt;SolicitudCambioTurno&amp;gt;&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="420" height="860" as="geometry"/></mxCell><mxCell id="v1"